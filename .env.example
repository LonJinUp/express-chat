BASE_MONGO_URL=mongodb://username:password@127.0.0.1:27017/expressChat?authSource=admin&replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_RETRY_INTERVAL_MS=3000
PASSWORD_SECRET=replace-with-a-long-random-secret
PORT=3992
E2EE_ENABLED=false
MESSAGE_RECALL_WINDOW_SECONDS=120
MESSAGE_EDIT_WINDOW_SECONDS=900
# 管理员账号的 userId 或 MongoDB _id，多个值使用英文逗号分隔
ADMIN_USER_IDS=
WS_HEARTBEAT_INTERVAL_MS=10000
PRESENCE_TOUCH_INTERVAL_MS=30000
# 单机默认 memory；多实例部署改为 redis
PRESENCE_DRIVER=memory
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=express-chat
PRESENCE_CONNECTION_TTL_SECONDS=45
PRESENCE_SWEEP_INTERVAL_MS=5000
# 生产多实例建议 false，避免 Redis 故障时各实例形成不一致的内存状态
PRESENCE_REDIS_FALLBACK_TO_MEMORY=true
# 实时事件总线默认跟随 PRESENCE_DRIVER，也可单独覆盖
# REALTIME_DRIVER=redis
REALTIME_REDIS_FALLBACK_TO_MEMORY=true
# 可选实例标签；进程会自动追加 PID 和随机值保证唯一
# INSTANCE_ID=chat-node

# 图片存储：local 或 oss
UPLOAD_DRIVER=local
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_AUDIO_MB=15
UPLOAD_MAX_VIDEO_MB=100
PUBLIC_BASE_URL=http://localhost:3992
# UPLOAD_LOCAL_DIR=/absolute/path/to/uploads

# UPLOAD_DRIVER=oss 时填写
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_PUBLIC_BASE_URL=https://cdn.example.com
