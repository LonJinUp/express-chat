BASE_MONGO_URL=mongodb://username:password@127.0.0.1:27017/expressChat?authSource=admin&replicaSet=rs0
PASSWORD_SECRET=replace-with-a-long-random-secret
PORT=3992
E2EE_ENABLED=false
MESSAGE_RECALL_WINDOW_SECONDS=120

# 图片存储：local 或 oss
UPLOAD_DRIVER=local
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_AUDIO_MB=15
PUBLIC_BASE_URL=http://localhost:3992
# UPLOAD_LOCAL_DIR=/absolute/path/to/uploads

# UPLOAD_DRIVER=oss 时填写
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_PUBLIC_BASE_URL=https://cdn.example.com
